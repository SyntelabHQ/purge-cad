<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PurgeCad.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PurgeCAD/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Accent for Fluent controls (checkboxes, radios, toggles, focus). A palette needs fixed colours, so these copy
         Themes/Tokens.axaml: Light = AccentColor, Dark = AccentHoverColor (one step softer than AccentColor, so the
         shades Fluent derives from it stay readable on the dark surfaces). Change both places together. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#18181B" />
        <ColorPaletteResources x:Key="Dark" Accent="#E4E4E7" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://PurgeCAD/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
