<!--
  Design tokens: the only place where colours, sizes, radii, spacing and fonts are defined.
  Views and styles use these keys through DynamicResource / StaticResource. Never hard-code values in views.
  Colours have a Light and a Dark value; switching theme only switches the dictionary.

  Palette idea: neutral ink-on-grey UI (Syntelab Apps style). The brown brand colour is kept for the
  app mark only; interaction uses the ink colour, status uses green / amber / red.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <!-- Brand (app mark only) -->
      <Color x:Key="BrandColor">#8A5A44</Color>
      <Color x:Key="OnBrandColor">#FFFFFF</Color>

      <!-- Interaction: ink -->
      <Color x:Key="AccentColor">#18181B</Color>
      <Color x:Key="AccentHoverColor">#3F3F46</Color>
      <Color x:Key="AccentPressedColor">#000000</Color>
      <Color x:Key="OnAccentColor">#FFFFFF</Color>
      <Color x:Key="AccentSubtleColor">#F4F4F5</Color>
      <Color x:Key="FocusColor">#2563EB</Color>

      <!-- Surfaces -->
      <Color x:Key="BackgroundColor">#F3F4F6</Color>
      <Color x:Key="TitleBarColor">#FFFFFF</Color>
      <Color x:Key="SidebarColor">#FFFFFF</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="SurfaceSunkenColor">#F4F4F5</Color>
      <Color x:Key="SurfaceHoverColor">#F4F4F5</Color>
      <Color x:Key="BorderColor">#E4E4E7</Color>
      <Color x:Key="BorderStrongColor">#D4D4D8</Color>

      <!-- Text -->
      <Color x:Key="TextPrimaryColor">#09090B</Color>
      <Color x:Key="TextSecondaryColor">#3F3F46</Color>
      <Color x:Key="TextMutedColor">#71717A</Color>

      <!-- Status -->
      <Color x:Key="SuccessColor">#15803D</Color>
      <Color x:Key="SuccessSubtleColor">#DCFCE7</Color>
      <Color x:Key="WarningColor">#A16207</Color>
      <Color x:Key="WarningSubtleColor">#FFFBEB</Color>
      <Color x:Key="DangerColor">#B91C1C</Color>
      <Color x:Key="DangerSubtleColor">#FEE2E2</Color>
      <Color x:Key="InfoColor">#1D4ED8</Color>
      <Color x:Key="InfoSubtleColor">#DBEAFE</Color>
      <Color x:Key="NeutralSubtleColor">#F4F4F5</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <!-- Check marks on the light accent box must be dark to stay readable (same value as OnAccentColor) -->
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#09090B" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#09090B" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#09090B" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="#09090B" />
      <Color x:Key="BrandColor">#C59077</Color>
      <Color x:Key="OnBrandColor">#1A120B</Color>

      <Color x:Key="AccentColor">#FAFAFA</Color>
      <Color x:Key="AccentHoverColor">#E4E4E7</Color>
      <Color x:Key="AccentPressedColor">#D4D4D8</Color>
      <Color x:Key="OnAccentColor">#09090B</Color>
      <Color x:Key="AccentSubtleColor">#27272A</Color>
      <Color x:Key="FocusColor">#60A5FA</Color>

      <Color x:Key="BackgroundColor">#09090B</Color>
      <Color x:Key="TitleBarColor">#111113</Color>
      <Color x:Key="SidebarColor">#111113</Color>
      <Color x:Key="SurfaceColor">#18181B</Color>
      <Color x:Key="SurfaceSunkenColor">#202023</Color>
      <Color x:Key="SurfaceHoverColor">#232326</Color>
      <Color x:Key="BorderColor">#27272A</Color>
      <Color x:Key="BorderStrongColor">#3F3F46</Color>

      <Color x:Key="TextPrimaryColor">#FAFAFA</Color>
      <Color x:Key="TextSecondaryColor">#D4D4D8</Color>
      <Color x:Key="TextMutedColor">#A1A1AA</Color>

      <Color x:Key="SuccessColor">#4ADE80</Color>
      <Color x:Key="SuccessSubtleColor">#13261A</Color>
      <Color x:Key="WarningColor">#FACC15</Color>
      <Color x:Key="WarningSubtleColor">#2A2410</Color>
      <Color x:Key="DangerColor">#F87171</Color>
      <Color x:Key="DangerSubtleColor">#2D1414</Color>
      <Color x:Key="InfoColor">#93C5FD</Color>
      <Color x:Key="InfoSubtleColor">#172033</Color>
      <Color x:Key="NeutralSubtleColor">#27272A</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- Brushes (theme-aware through the colours above) -->
  <SolidColorBrush x:Key="Brand" Color="{DynamicResource BrandColor}" />
  <SolidColorBrush x:Key="OnBrand" Color="{DynamicResource OnBrandColor}" />
  <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHover" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressed" Color="{DynamicResource AccentPressedColor}" />
  <SolidColorBrush x:Key="OnAccent" Color="{DynamicResource OnAccentColor}" />
  <SolidColorBrush x:Key="AccentSubtle" Color="{DynamicResource AccentSubtleColor}" />
  <SolidColorBrush x:Key="Focus" Color="{DynamicResource FocusColor}" />
  <SolidColorBrush x:Key="Background" Color="{DynamicResource BackgroundColor}" />
  <SolidColorBrush x:Key="TitleBar" Color="{DynamicResource TitleBarColor}" />
  <SolidColorBrush x:Key="Sidebar" Color="{DynamicResource SidebarColor}" />
  <SolidColorBrush x:Key="Surface" Color="{DynamicResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceSunken" Color="{DynamicResource SurfaceSunkenColor}" />
  <SolidColorBrush x:Key="SurfaceHover" Color="{DynamicResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="Border" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrong" Color="{DynamicResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource TextMutedColor}" />
  <SolidColorBrush x:Key="Success" Color="{DynamicResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessSubtle" Color="{DynamicResource SuccessSubtleColor}" />
  <SolidColorBrush x:Key="Warning" Color="{DynamicResource WarningColor}" />
  <SolidColorBrush x:Key="WarningSubtle" Color="{DynamicResource WarningSubtleColor}" />
  <SolidColorBrush x:Key="Danger" Color="{DynamicResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSubtle" Color="{DynamicResource DangerSubtleColor}" />
  <SolidColorBrush x:Key="Info" Color="{DynamicResource InfoColor}" />
  <SolidColorBrush x:Key="InfoSubtle" Color="{DynamicResource InfoSubtleColor}" />
  <SolidColorBrush x:Key="NeutralSubtle" Color="{DynamicResource NeutralSubtleColor}" />

  <!-- Typography -->
  <FontFamily x:Key="FontBrand">avares://PurgeCAD/Assets/Fonts#Sansation</FontFamily>
  <FontFamily x:Key="FontUi">avares://PurgeCAD/Assets/Fonts#Noto Sans</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
  <x:Double x:Key="FontSizeCaption">11.5</x:Double>
  <x:Double x:Key="FontSizeSmall">12</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeSubtitle">14</x:Double>
  <x:Double x:Key="FontSizeTitle">16</x:Double>
  <x:Double x:Key="FontSizeStat">17</x:Double>
  <x:Double x:Key="FontSizeBrand">15</x:Double>
  <x:Double x:Key="FontSizeHero">26</x:Double>

  <!-- Spacing scale (4 px grid) -->
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">20</x:Double>
  <x:Double x:Key="Space6">24</x:Double>
  <!-- Half steps for tight groups -->
  <x:Double x:Key="SpaceHair">1</x:Double>
  <x:Double x:Key="SpaceXs">2</x:Double>
  <x:Double x:Key="SpaceChip">5</x:Double>
  <!-- Icon + label, and the gap between stat boxes -->
  <x:Double x:Key="SpaceInline">6</x:Double>

  <!-- One-sided gaps (Start / End mirror in right-to-left languages) -->
  <Thickness x:Key="GapEndXs">0,0,4,0</Thickness>
  <Thickness x:Key="GapEndSm">0,0,6,0</Thickness>
  <Thickness x:Key="GapEnd">0,0,8,0</Thickness>
  <Thickness x:Key="GapEndMd">0,0,10,0</Thickness>
  <Thickness x:Key="GapEndLg">0,0,12,0</Thickness>
  <Thickness x:Key="GapStartSm">6,0,0,0</Thickness>
  <Thickness x:Key="GapStart">8,0,0,0</Thickness>
  <Thickness x:Key="GapStartMd">10,0,0,0</Thickness>
  <Thickness x:Key="GapStartLg">12,0,0,0</Thickness>
  <Thickness x:Key="GapAboveXs">0,4,0,0</Thickness>
  <Thickness x:Key="GapBelow">0,0,0,8</Thickness>
  <Thickness x:Key="GapBelowLg">0,0,0,12</Thickness>
  <Thickness x:Key="GapInlineXs">4,0</Thickness>
  <Thickness x:Key="GapInlineSm">6,0</Thickness>
  <!-- Leading icon next to text: nudged down to sit on the first line -->
  <Thickness x:Key="IconLead">0,1,8,0</Thickness>
  <Thickness x:Key="IconLeadTall">0,2,8,0</Thickness>
  <!-- Pulls a row up to sit closer to the block above (About: logs under links) -->
  <Thickness x:Key="PullUp">0,-8,0,0</Thickness>
  <Thickness x:Key="FieldLabelMargin">2,0,10,0</Thickness>
  <Thickness x:Key="TitleBarStart">14,0,0,0</Thickness>
  <Thickness x:Key="TitleBarEnd">0,0,10,0</Thickness>
  <!-- Check box under a notice icon, lined up with the notice text -->
  <Thickness x:Key="NoticeIndent">22,0,0,0</Thickness>
  <Thickness x:Key="LinkCellMargin">0,0,4,4</Thickness>
  <Thickness x:Key="ChipMargin">0,0,6,6</Thickness>
  <Thickness x:Key="TileDotMargin">0,1,10,0</Thickness>
  <Thickness x:Key="CreditValueMargin">0,2</Thickness>
  <Thickness x:Key="CreditLabelMargin">0,2,16,2</Thickness>
  <Thickness x:Key="DialogInset">20</Thickness>
  <Thickness x:Key="GapTopXs">0,2,0,0</Thickness>
  <Thickness x:Key="GapTopSm">0,4,0,0</Thickness>
  <Thickness x:Key="GapTopLg">0,16,0,0</Thickness>
  <Thickness x:Key="AboutInset">20,20,20,16</Thickness>
  <Thickness x:Key="WelcomeHeroInset">24,36,24,8</Thickness>
  <Thickness x:Key="WelcomeBodyInset">28,20,28,28</Thickness>
  <Thickness x:Key="PaddingControl">12,6</Thickness>
  <Thickness x:Key="PaddingChip">10,4</Thickness>
  <Thickness x:Key="PaddingChipIcon">8,4</Thickness>
  <Thickness x:Key="PaddingTile">12,8</Thickness>
  <Thickness x:Key="PaddingCard">16</Thickness>
  <Thickness x:Key="PaddingSidebar">14,12,12,14</Thickness>
  <!-- Gap between sidebar sections; kept tight so the sidebar fits small screens -->
  <x:Double x:Key="SidebarGap">14</x:Double>
  <Thickness x:Key="PaddingMain">16</Thickness>
  <Thickness x:Key="PaddingIcon">6</Thickness>
  <Thickness x:Key="PaddingSegmented">2</Thickness>
  <Thickness x:Key="PaddingSegment">10,4</Thickness>
  <Thickness x:Key="PaddingRow">14,8</Thickness>
  <Thickness x:Key="PaddingStat">10,6</Thickness>
  <Thickness x:Key="PaddingNotice">10,8</Thickness>
  <Thickness x:Key="PaddingBadge">7,0</Thickness>
  <Thickness x:Key="PaddingStatus">8,1</Thickness>
  <Thickness x:Key="PaddingButtonLarge">16,6</Thickness>
  <Thickness x:Key="PaddingButtonRow">8,6</Thickness>
  <Thickness x:Key="PaddingListItem">10,6</Thickness>
  <Thickness x:Key="PaddingList">4</Thickness>
  <Thickness x:Key="PaddingSegmentWide">10,6</Thickness>
  <Thickness x:Key="PaddingSegmentCompact">8,4</Thickness>
  <Thickness x:Key="PaddingSegmentSmall">8,3</Thickness>
  <Thickness x:Key="PaddingGhostSmall">8,2</Thickness>
  <Thickness x:Key="PaddingCheckLabel">6,0,0,0</Thickness>

  <!-- Shape -->
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
  <CornerRadius x:Key="RadiusAppMarkDialog">10</CornerRadius>
  <CornerRadius x:Key="RadiusAppMarkHero">14</CornerRadius>
  <CornerRadius x:Key="RadiusTileDot">8</CornerRadius>
  <Thickness x:Key="BorderThin">1</Thickness>
  <Thickness x:Key="BorderTop">0,1,0,0</Thickness>
  <Thickness x:Key="BorderBottom">0,0,0,1</Thickness>
  <Thickness x:Key="BorderTileDot">1.5</Thickness>
  <x:Double x:Key="HairlineSize">1</x:Double>

  <!-- Elevation -->
  <BoxShadows x:Key="ShadowRaised">0 1 2 0 #26000000</BoxShadows>
  <BoxShadows x:Key="ShadowPopup">0 8 24 0 #26000000</BoxShadows>

  <!-- Sizes -->
  <x:Double x:Key="TitleBarHeight">40</x:Double>
  <x:Double x:Key="ControlHeight">32</x:Double>
  <x:Double x:Key="ControlHeightLarge">36</x:Double>
  <x:Double x:Key="IconSizeTiny">10</x:Double>
  <x:Double x:Key="IconSizeCheck">11</x:Double>
  <x:Double x:Key="IconSizeXSmall">12</x:Double>
  <x:Double x:Key="IconSizeSmall">13</x:Double>
  <x:Double x:Key="IconSize">14</x:Double>
  <x:Double x:Key="IconSizeLarge">16</x:Double>
  <x:Double x:Key="IconSizeXLarge">18</x:Double>
  <x:Double x:Key="IconSizeDialog">24</x:Double>
  <x:Double x:Key="IconSizeHero">32</x:Double>
  <x:Double x:Key="BrandIconSize">16</x:Double>
  <x:Double x:Key="AppMarkSize">22</x:Double>
  <x:Double x:Key="AppMarkSizeDialog">44</x:Double>
  <x:Double x:Key="AppMarkSizeHero">60</x:Double>
  <x:Double x:Key="IconTileSizeSmall">26</x:Double>
  <x:Double x:Key="IconTileSize">30</x:Double>
  <x:Double x:Key="IconTileSizeLarge">44</x:Double>
  <x:Double x:Key="TileDotSize">16</x:Double>
  <x:Double x:Key="TileDotInnerSize">6</x:Double>
  <x:Double x:Key="FontSizeDialogBrand">20</x:Double>
  <GridLength x:Key="SidebarWidth">364</GridLength>
  <x:Double x:Key="SidebarMinWidth">280</x:Double>
  <x:Double x:Key="SidebarMaxWidth">560</x:Double>
  <x:Double x:Key="SplitterWidth">6</x:Double>
  <x:Double x:Key="SplitterLineWidth">1</x:Double>
  <x:Double x:Key="SplitterLineWidthHover">3</x:Double>
  <x:Double x:Key="WindowWidth">1200</x:Double>
  <x:Double x:Key="WindowHeight">780</x:Double>
  <x:Double x:Key="WindowMinWidth">860</x:Double>
  <x:Double x:Key="WindowMinHeight">560</x:Double>
  <x:Double x:Key="MainMinWidth">420</x:Double>
  <x:Double x:Key="AboutWidth">540</x:Double>
  <x:Double x:Key="AboutHeight">640</x:Double>
  <x:Double x:Key="AboutMinWidth">440</x:Double>
  <x:Double x:Key="AboutMinHeight">460</x:Double>
  <x:Double x:Key="WelcomeWidth">440</x:Double>
  <x:Double x:Key="ConfirmWidth">460</x:Double>
  <x:Double x:Key="ConfirmListMaxHeight">280</x:Double>
  <x:Double x:Key="FlyoutWidth">420</x:Double>
  <x:Double x:Key="FlyoutTextMaxWidth">300</x:Double>
  <!-- recent folders, profiles, size filter -->
  <x:Double x:Key="FlyoutWidthNarrow">320</x:Double>
  <x:Double x:Key="SizeFieldWidth">96</x:Double>
  <x:Double x:Key="EmptyStateMaxWidth">320</x:Double>
  <x:Double x:Key="LanguagePopupWidth">360</x:Double>
  <x:Double x:Key="LanguageListMaxHeight">360</x:Double>
  <x:Double x:Key="PopupOffset">6</x:Double>
  <x:Double x:Key="RunButtonMinWidth">120</x:Double>
  <x:Double x:Key="DialogButtonMinWidth">90</x:Double>
  <x:Double x:Key="CloseButtonMinWidth">80</x:Double>
  <x:Double x:Key="SegmentMinWidth">30</x:Double>
  <x:Double x:Key="CheckRowMinHeight">28</x:Double>
  <x:Double x:Key="ScanProgressWidth">80</x:Double>
  <x:Double x:Key="ProgressHeight">6</x:Double>
  <x:Double x:Key="DisabledOpacity">0.5</x:Double>
  <x:Double x:Key="ExcludedOpacity">0.55</x:Double>
  <!-- Fluent scroll bars: 7 px instead of 12 -->
  <x:Double x:Key="ScrollBarSize">7</x:Double>
  <x:Double x:Key="ScrollBarButtonArrowIconFontSize">6</x:Double>

