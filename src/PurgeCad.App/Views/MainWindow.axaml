<!--
  Main window. DataContext: MainViewModel. Every colour / size comes from Themes/Tokens.axaml,
  every component look from Themes/Controls.axaml.

  Layout:  custom title bar (app mark · name · language · Light/Dark · about · system buttons)
           sidebar (mode · folder · options)  ║ splitter ║  main (run panel · results)
  The window draws into the title bar area on Windows and macOS; on Linux the system title bar stays
  and this bar is a normal header (see MainWindow.axaml.cs).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:PurgeCad.App.Services"
        xmlns:b="using:PurgeCad.Core.Branding"
        xmlns:c="using:PurgeCad.App.Controls"
        x:Class="PurgeCad.App.Views.MainWindow"
        Icon="/Assets/purge-cad.ico"
        Title="{x:Static b:Brand.AppName}" Width="{StaticResource WindowWidth}" Height="{StaticResource WindowHeight}"
        MinWidth="{StaticResource WindowMinWidth}" MinHeight="{StaticResource WindowMinHeight}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="{StaticResource TitleBarHeight}"
        DragDrop.AllowDrop="True"
        FlowDirection="{Binding Language.RightToLeft, Source={x:Static s:Loc.Instance}, Converter={x:Static s:Converters.FlowDirection}}">

  <DockPanel Margin="{Binding $parent[Window].OffScreenMargin}">
    <!-- ================= Title bar ================= -->
    <Border DockPanel.Dock="Top" Classes="titleBar" x:Name="TitleBar">
      <Grid x:Name="TitleBarGrid" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space2}" VerticalAlignment="Center"
                    Margin="{StaticResource TitleBarStart}" IsHitTestVisible="False">
          <Border Classes="appMark">
            <PathIcon Data="{StaticResource IconPurgeCad}" />
          </Border>
          <TextBlock Classes="brand" Text="{Binding AppName}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource Space1}" VerticalAlignment="Center"
                    Margin="{StaticResource TitleBarEnd}">
          <!-- A newer version: download page, or skip it -->
          <Button Classes="update" IsVisible="{Binding HasUpdate}" Margin="{StaticResource GapEndSm}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
              <PathIcon Data="{StaticResource IconDownload}" Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}" />
              <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="{StaticResource Space2}" MaxWidth="{StaticResource FlyoutTextMaxWidth}">
                  <TextBlock Text="{Binding UpdateText}" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding CanInstallUpdate}"
                             Text="{Binding [update.body.install], Source={x:Static s:Loc.Instance}}" />
                  <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !CanInstallUpdate}"
                             Text="{Binding [update.body.download], Source={x:Static s:Loc.Instance}}" />
                  <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsRunning}"
                             Text="{Binding [update.afterRun], Source={x:Static s:Loc.Instance}}" />
                  <TextBlock Classes="caption" Text="{Binding UpdateProgress}" FontWeight="Medium"
                             IsVisible="{Binding UpdateProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                    <Button Classes="primary" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding CanInstallUpdate}"
                            Content="{Binding [update.install], Source={x:Static s:Loc.Instance}}" />
                    <Button Classes="primary" Command="{Binding OpenUpdatePageCommand}" IsVisible="{Binding !CanInstallUpdate}"
                            Content="{Binding [update.download], Source={x:Static s:Loc.Instance}}" />
                    <Button Command="{Binding SkipUpdateCommand}" IsEnabled="{Binding !IsUpdating}"
                            Content="{Binding [update.skip], Source={x:Static s:Loc.Instance}}" />
                  </StackPanel>
                  <Button Classes="ghost" Command="{Binding OpenUpdatePageCommand}" IsVisible="{Binding CanInstallUpdate}"
                          Padding="0" Content="{Binding [update.whatsNew], Source={x:Static s:Loc.Instance}}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <c:LanguagePicker Classes="compact" DataContext="{Binding Languages}" VerticalAlignment="Center" />
          <c:ThemeSwitch Classes="compact" VerticalAlignment="Center" Margin="{StaticResource GapInlineXs}" />
          <Button Classes="icon" Command="{Binding ShowAboutCommand}"
                  ToolTip.Tip="{Binding [about.title], Source={x:Static s:Loc.Instance}}">
            <PathIcon Data="{StaticResource IconInfo}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource SidebarWidth}"
                          MinWidth="{StaticResource SidebarMinWidth}" MaxWidth="{StaticResource SidebarMaxWidth}" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="{StaticResource MainMinWidth}" />
      </Grid.ColumnDefinitions>

      <!-- ================= Sidebar ================= -->
      <Border Classes="sidebar">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="{StaticResource PaddingSidebar}" Spacing="{StaticResource SidebarGap}">

            <!-- Tabs: purge, cleanup, convert -->
            <Border Classes="segmented">
              <UniformGrid Columns="3">
                <RadioButton Classes="segment tab" GroupName="tab" IsChecked="{Binding IsPurgeMode}" Padding="{StaticResource PaddingSegmentCompact}"
                             ToolTip.Tip="{Binding [tab.purge], Source={x:Static s:Loc.Instance}}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
                    <PathIcon Data="{StaticResource IconPurgeCad}" />
                    <TextBlock Text="{Binding [mode.purge], Source={x:Static s:Loc.Instance}}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Classes="segment tab" GroupName="tab" IsChecked="{Binding IsCleanMode}" Padding="{StaticResource PaddingSegmentCompact}"
                             ToolTip.Tip="{Binding [tab.cleanup], Source={x:Static s:Loc.Instance}}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
                    <PathIcon Data="{StaticResource IconBroom}" />
                    <TextBlock Text="{Binding [mode.cleanup], Source={x:Static s:Loc.Instance}}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Classes="segment tab" GroupName="tab" IsChecked="{Binding IsConvertMode}" Padding="{StaticResource PaddingSegmentCompact}"
                             ToolTip.Tip="{Binding [tab.convert], Source={x:Static s:Loc.Instance}}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
                    <PathIcon Data="{StaticResource IconConvert}" />
                    <TextBlock Text="{Binding [mode.convert], Source={x:Static s:Loc.Instance}}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </RadioButton>
              </UniformGrid>
            </Border>

            <!-- Folder (or the drawings chosen in Explorer) -->
            <StackPanel Spacing="{StaticResource Space2}">
              <TextBlock Classes="section" Text="{Binding [source.folder], Source={x:Static s:Loc.Instance}}" />
              <Border Classes="tile">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="iconTile" Margin="{StaticResource GapEndMd}" VerticalAlignment="Center">
                    <Panel>
                      <PathIcon Data="{StaticResource IconFolder}" IsVisible="{Binding !IsFileMode}" />
                      <PathIcon Data="{StaticResource IconFile}" IsVisible="{Binding IsFileMode}" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding HasFolder}" />
                    <TextBlock Classes="caption" Text="{Binding Folder}" TextTrimming="PathSegmentEllipsis"
                               IsVisible="{Binding HasFolder}" ToolTip.Tip="{Binding Folder}" />
                    <TextBlock Text="{Binding [source.empty], Source={x:Static s:Loc.Instance}}" FontWeight="SemiBold"
                               IsVisible="{Binding !HasFolder}" />
                    <TextBlock Classes="caption" Text="{Binding [source.dropHint], Source={x:Static s:Loc.Instance}}"
                               IsVisible="{Binding !HasFolder}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource SpaceXs}"
                              Margin="{StaticResource GapStartMd}" VerticalAlignment="Center">
                    <!-- Recent folders -->
                    <Button x:Name="RecentButton" Classes="icon" IsVisible="{Binding HasRecentFolders}" IsEnabled="{Binding !IsRunning}"
                            ToolTip.Tip="{Binding [source.recent], Source={x:Static s:Loc.Instance}}">
                      <PathIcon Data="{StaticResource IconHistory}" />
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel x:Name="RecentList" Width="{StaticResource FlyoutWidthNarrow}" Spacing="{StaticResource SpaceXs}">
                            <TextBlock Classes="section" Text="{Binding [source.recent], Source={x:Static s:Loc.Instance}}"
                                       Margin="{StaticResource GapBelow}" />
                            <ItemsControl ItemsSource="{Binding RecentFolders}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                          Padding="{StaticResource PaddingListItem}"
                                          Command="{Binding $parent[Window].DataContext.OpenRecentCommand}" CommandParameter="{Binding Path}">
                                    <StackPanel>
                                      <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                      <TextBlock Classes="caption" Text="{Binding Path}" TextTrimming="PathSegmentEllipsis" />
                                    </StackPanel>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator />
                            <Button Classes="ghost" Padding="{StaticResource PaddingGhostSmall}" Command="{Binding ClearRecentCommand}"
                                    Content="{Binding [source.recent.clear], Source={x:Static s:Loc.Instance}}" />
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <Button Classes="icon" Command="{Binding RescanCommand}" IsEnabled="{Binding HasFolder}"
                            ToolTip.Tip="{Binding [source.rescan], Source={x:Static s:Loc.Instance}}">
                      <PathIcon Data="{StaticResource IconRefresh}" />
                    </Button>
                    <Button x:Name="ChooseFolder" Content="{Binding [common.browse], Source={x:Static s:Loc.Instance}}" />
                  </StackPanel>
                </Grid>
              </Border>
              <WrapPanel>
                <!-- drawings chosen in Explorer: one chip back to the whole folder -->
                <Button Classes="chip" Command="{Binding ShowWholeFolderCommand}" IsVisible="{Binding IsFileMode}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceChip}">
                    <PathIcon Data="{StaticResource IconFolder}" Width="{StaticResource IconSizeXSmall}" Height="{StaticResource IconSizeXSmall}" />
                    <TextBlock Text="{Binding [source.wholeFolder], Source={x:Static s:Loc.Instance}}" />
                  </StackPanel>
                </Button>
                <ToggleButton Classes="chip" IsChecked="{Binding IncludeSubfolders}" IsVisible="{Binding !IsFileMode}"
                              Content="{Binding [source.subfolders], Source={x:Static s:Loc.Instance}}" />
                <ToggleButton Classes="chip" IsChecked="{Binding IncludeDwg}" IsVisible="{Binding !IsFileMode}"
                              Content="{Binding [source.dwg], Source={x:Static s:Loc.Instance}}" />
                <ToggleButton Classes="chip" IsChecked="{Binding IncludeDxf}" IsVisible="{Binding !IsFileMode}"
                              Content="{Binding [source.dxf], Source={x:Static s:Loc.Instance}}" />
              </WrapPanel>
              <!-- Name filter, and the size filter in a small flyout next to it -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceInline}">
                <TextBox Text="{Binding NameFilterText}"
                         Watermark="{Binding [source.filter.hint], Source={x:Static s:Loc.Instance}}"
                         ToolTip.Tip="{Binding [source.filter.tip], Source={x:Static s:Loc.Instance}}">
                  <TextBox.InnerLeftContent>
                    <PathIcon Data="{StaticResource IconSearch}" Margin="{StaticResource GapStart}" />
                  </TextBox.InnerLeftContent>
                  <TextBox.InnerRightContent>
                    <Button Classes="icon" Command="{Binding ClearNameFilterCommand}" IsVisible="{Binding HasNameFilter}"
                            Padding="{StaticResource PaddingIcon}" Margin="{StaticResource GapEndXs}"
                            ToolTip.Tip="{Binding [source.filter.clear], Source={x:Static s:Loc.Instance}}">
                      <PathIcon Data="{StaticResource IconClose}" Width="{StaticResource IconSizeTiny}" Height="{StaticResource IconSizeTiny}" />
                    </Button>
                  </TextBox.InnerRightContent>
                </TextBox>
                <Button Grid.Column="1" VerticalAlignment="Stretch" Classes.active="{Binding HasSizeFilter}"
                        ToolTip.Tip="{Binding [source.size], Source={x:Static s:Loc.Instance}}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
                    <TextBlock Text="{Binding SizeFilterText}" VerticalAlignment="Center" />
                    <PathIcon Data="{StaticResource IconChevronDown}" Width="{StaticResource IconSizeXSmall}" Height="{StaticResource IconSizeXSmall}" />
                  </StackPanel>
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                      <StackPanel Spacing="{StaticResource Space2}">
                        <TextBlock Classes="section" Text="{Binding [source.size], Source={x:Static s:Loc.Instance}}" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
                          <TextBox Text="{Binding MinSizeText}" Width="{StaticResource SizeFieldWidth}"
                                   Watermark="{Binding [source.size.min], Source={x:Static s:Loc.Instance}}" />
                          <TextBlock Text="–" VerticalAlignment="Center" />
                          <TextBox Text="{Binding MaxSizeText}" Width="{StaticResource SizeFieldWidth}"
                                   Watermark="{Binding [source.size.max], Source={x:Static s:Loc.Instance}}" />
                          <TextBlock Classes="caption" Text="MB" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Classes="ghost" Padding="{StaticResource PaddingGhostSmall}" Command="{Binding ClearSizeFilterCommand}"
                                IsVisible="{Binding HasSizeFilter}" Content="{Binding [source.filter.clear], Source={x:Static s:Loc.Instance}}" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" IsVisible="{Binding IsScanning}">
                <ProgressBar IsIndeterminate="True" Width="{StaticResource ScanProgressWidth}" VerticalAlignment="Center" />
                <TextBlock Classes="caption" Text="{Binding [scan.scanning], Source={x:Static s:Loc.Instance}}" />
              </StackPanel>
            </StackPanel>

            <!-- ===== Purge options ===== -->
            <StackPanel Spacing="{StaticResource SidebarGap}" IsVisible="{Binding IsPurgeMode}">

              <!-- Engine: one segmented choice, the chosen engine's risks under it; profiles on the right -->
              <StackPanel Spacing="{StaticResource Space2}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="{Binding [options.engine], Source={x:Static s:Loc.Instance}}" VerticalAlignment="Center" />
                  <Button x:Name="ProfilesButton" Grid.Column="1" Classes="ghost" Padding="{StaticResource PaddingGhostSmall}"
                          IsEnabled="{Binding !IsRunning}" ToolTip.Tip="{Binding [profiles.tip], Source={x:Static s:Loc.Instance}}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
                      <PathIcon Data="{StaticResource IconProfiles}" Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}" />
                      <TextBlock Text="{Binding [profiles.title], Source={x:Static s:Loc.Instance}}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" />
                      <PathIcon Data="{StaticResource IconChevronDown}" Width="{StaticResource IconSizeTiny}" Height="{StaticResource IconSizeTiny}" />
                    </StackPanel>
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel x:Name="ProfileList" Width="{StaticResource FlyoutWidthNarrow}" Spacing="{StaticResource Space2}">
                          <TextBlock Classes="section" Text="{Binding [profiles.title], Source={x:Static s:Loc.Instance}}" />
                          <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !HasProfiles}"
                                     Text="{Binding [profiles.empty], Source={x:Static s:Loc.Instance}}" />
                          <ItemsControl ItemsSource="{Binding ProfileNames}" IsVisible="{Binding HasProfiles}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto">
                                  <Button Classes="ghost apply" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                          Padding="{StaticResource PaddingListItem}" Content="{Binding}"
                                          Command="{Binding $parent[Window].DataContext.ApplyProfileCommand}" CommandParameter="{Binding}" />
                                  <Button Grid.Column="1" Classes="icon" Command="{Binding $parent[Window].DataContext.DeleteProfileCommand}"
                                          CommandParameter="{Binding}" ToolTip.Tip="{Binding [profiles.delete], Source={x:Static s:Loc.Instance}}">
                                    <PathIcon Data="{StaticResource IconTrash}" Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}" />
                                  </Button>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Separator />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceInline}">
                            <TextBox Text="{Binding NewProfileName}"
                                     Watermark="{Binding [profiles.name], Source={x:Static s:Loc.Instance}}">
                              <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SaveProfileCommand}" />
                              </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1" Classes="primary" Command="{Binding SaveProfileCommand}"
                                    Content="{Binding [profiles.save], Source={x:Static s:Loc.Instance}}" />
                          </Grid>
                          <TextBlock Classes="caption" TextWrapping="Wrap"
                                     Text="{Binding [profiles.saveHint], Source={x:Static s:Loc.Instance}}" />
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
                <Border Classes="segmented">
                  <ItemsControl ItemsSource="{Binding Engines}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <RadioButton Classes="segment" GroupName="engine" IsEnabled="{Binding IsAvailable}"
                                     Padding="{StaticResource PaddingSegmentCompact}"
                                     Command="{Binding $parent[Window].DataContext.SelectEngineCommand}" CommandParameter="{Binding}"
                                     IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip.Tip="{Binding UnavailableReason}">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </RadioButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <Grid ColumnDefinitions="Auto,*" DataContext="{Binding SelectedEngine}">
                  <Border Classes="badge" Classes.VeryLow="{Binding IsVeryLow}" Classes.Medium="{Binding IsMedium}"
                          IsVisible="{Binding HasRisk}" VerticalAlignment="Top" Margin="{StaticResource GapEnd}">
                    <TextBlock Text="{Binding RiskText}" />
                  </Border>
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Risks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
                <TextBlock Classes="caption" Text="{Binding UnavailableNote}" TextWrapping="Wrap" Opacity="{StaticResource DisabledOpacity}"
                           IsVisible="{Binding HasUnavailableNote}" />
              </StackPanel>

              <!-- What to purge, and the version to save in: two compact choices side by side -->
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceInline}" RowSpacing="{StaticResource Space2}">
                <TextBlock Classes="section" Text="{Binding [options.what], Source={x:Static s:Loc.Instance}}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Classes="section" Text="{Binding [saveAs.title], Source={x:Static s:Loc.Instance}}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="{Binding CategorySummaryText}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Data="{StaticResource IconCheck}" Margin="{StaticResource GapEnd}" />
                    <TextBlock Grid.Column="1" Text="{Binding CategorySummary}" VerticalAlignment="Center" />
                    <PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="{StaticResource IconSizeXSmall}" Height="{StaticResource IconSizeXSmall}" />
                  </Grid>
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                      <StackPanel Width="{StaticResource FlyoutWidth}" Spacing="{StaticResource Space2}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <TextBlock Classes="section" Text="{Binding [options.what], Source={x:Static s:Loc.Instance}}"
                                     VerticalAlignment="Center" />
                          <Button Grid.Column="1" Classes="ghost" Padding="{StaticResource PaddingGhostSmall}" Command="{Binding SelectCategoriesCommand}"
                                  CommandParameter="all" Content="{Binding [options.what.all], Source={x:Static s:Loc.Instance}}" />
                          <Button Grid.Column="2" Classes="ghost" Padding="{StaticResource PaddingGhostSmall}" Command="{Binding SelectCategoriesCommand}"
                                  CommandParameter="none" Content="{Binding [options.what.none], Source={x:Static s:Loc.Instance}}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Categories}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <CheckBox IsChecked="{Binding IsChecked}" ToolTip.Tip="{Binding DangerHint}" MinHeight="{StaticResource CheckRowMinHeight}"
                                        Padding="{StaticResource PaddingCheckLabel}">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}"
                                           Classes.warning="{Binding IsOptIn}" />
                              </CheckBox>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="{Binding [options.what.optInNote], Source={x:Static s:Loc.Instance}}" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ItemsSource="{Binding SaveVersionChoices}" SelectedItem="{Binding SelectedSaveVersion}"
                          ToolTip.Tip="{Binding [saveAs.tip], Source={x:Static s:Loc.Instance}}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <TextBlock Classes="caption warning" Text="{Binding MissingRefsNote}" TextWrapping="Wrap"
                         IsVisible="{Binding MissingRefsNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <!-- More options -->
              <StackPanel Spacing="{StaticResource Space2}">
                <TextBlock Classes="section" Text="{Binding [options.more], Source={x:Static s:Loc.Instance}}" />
                <Border Classes="tile" Padding="0">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="{StaticResource PaddingTile}">
                      <TextBlock Text="{Binding [cleanup.alsoDuringPurge], Source={x:Static s:Loc.Instance}}"
                                 TextWrapping="Wrap" VerticalAlignment="Center" Margin="{StaticResource GapEnd}" />
                      <ToggleSwitch Grid.Column="1" IsChecked="{Binding CleanDuringPurge}" />
                    </Grid>
                    <Separator />
                    <Grid ColumnDefinitions="*,Auto" Margin="{StaticResource PaddingTile}">
                      <TextBlock Text="{Binding [options.parallel], Source={x:Static s:Loc.Instance}}"
                                 TextWrapping="Wrap" VerticalAlignment="Center" Margin="{StaticResource GapEnd}" />
                      <Border Grid.Column="1" Classes="segmented">
                        <ItemsControl ItemsSource="{Binding ParallelChoices}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <RadioButton Classes="segment" GroupName="parallel" IsChecked="{Binding IsSelected}"
                                           Content="{Binding Label}" MinWidth="{StaticResource SegmentMinWidth}" Padding="{StaticResource PaddingSegmentSmall}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </Grid>
                    <!-- Risky ACadSharp option (ACadSharp or Automatic, which can fall back to it) -->
                    <Separator IsVisible="{Binding ShowAllowUnknown}" />
                    <Grid ColumnDefinitions="*,Auto" Margin="{StaticResource PaddingTile}" IsVisible="{Binding ShowAllowUnknown}"
                          ToolTip.Tip="{Binding [options.allowUnknown.risk], Source={x:Static s:Loc.Instance}}">
                      <StackPanel Spacing="{StaticResource SpaceXs}" Margin="{StaticResource GapEnd}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [options.allowUnknown], Source={x:Static s:Loc.Instance}}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption warning" TextWrapping="Wrap" IsVisible="{Binding AllowUnknownObjects}"
                                   Text="{Binding [options.allowUnknown.risk], Source={x:Static s:Loc.Instance}}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowUnknownObjects}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>

            <!-- ===== Convert options: the version, and the engine ===== -->
            <StackPanel Spacing="{StaticResource SidebarGap}" IsVisible="{Binding IsConvertMode}">
              <StackPanel Spacing="{StaticResource Space2}">
                <TextBlock Classes="section" Text="{Binding [convert.to], Source={x:Static s:Loc.Instance}}" />
                <Border Classes="segmented">
                  <ItemsControl ItemsSource="{Binding ConvertChoices}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <RadioButton Classes="segment" GroupName="convertTo" IsChecked="{Binding IsSelected}"
                                     Padding="{StaticResource PaddingSegmentCompact}" ToolTip.Tip="{Binding Name}">
                          <TextBlock Text="{Binding Short}" />
                        </RadioButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding [convert.hint], Source={x:Static s:Loc.Instance}}" />
              </StackPanel>
              <StackPanel Spacing="{StaticResource Space2}">
                <TextBlock Classes="section" Text="{Binding [convert.engine], Source={x:Static s:Loc.Instance}}" />
                <Border Classes="segmented">
                  <ItemsControl ItemsSource="{Binding Engines}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <RadioButton Classes="segment" GroupName="convertEngine" IsEnabled="{Binding IsAvailable}"
                                     Padding="{StaticResource PaddingSegmentCompact}"
                                     Command="{Binding $parent[Window].DataContext.SelectEngineCommand}" CommandParameter="{Binding}"
                                     IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip.Tip="{Binding UnavailableReason}">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </RadioButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding [convert.engineHint], Source={x:Static s:Loc.Instance}}" />
              </StackPanel>
            </StackPanel>

            <!-- ===== Cleanup options ===== -->
            <StackPanel Spacing="{StaticResource Space2}" IsVisible="{Binding IsCleanMode}">
              <TextBlock Classes="section" Text="{Binding [tab.cleanup], Source={x:Static s:Loc.Instance}}" />
              <Border Classes="tile" Padding="0">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto" Margin="{StaticResource PaddingTile}">
                    <StackPanel Spacing="{StaticResource SpaceXs}" Margin="{StaticResource GapEnd}">
                      <TextBlock Text="{Binding [cleanup.lock], Source={x:Static s:Loc.Instance}}" FontWeight="SemiBold" />
                      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding [cleanup.lock.hint], Source={x:Static s:Loc.Instance}}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" x:Name="CleanLock" IsChecked="{Binding Cleanup.LockFiles}" />
                  </Grid>
                  <Separator />
                  <Grid ColumnDefinitions="*,Auto" Margin="{StaticResource PaddingTile}">
                    <StackPanel Spacing="{StaticResource SpaceXs}" Margin="{StaticResource GapEnd}">
                      <TextBlock Text="{Binding [cleanup.bak], Source={x:Static s:Loc.Instance}}" FontWeight="SemiBold" />
                      <TextBlock Classes="caption warning" TextWrapping="Wrap" Text="{Binding [cleanup.bak.hint], Source={x:Static s:Loc.Instance}}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" x:Name="CleanBak" IsChecked="{Binding Cleanup.Backups}" />
                  </Grid>
                  <Separator />
                  <Grid ColumnDefinitions="*,Auto" Margin="{StaticResource PaddingTile}">
                    <TextBlock Text="{Binding [cleanup.autosave], Source={x:Static s:Loc.Instance}}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="{StaticResource GapEnd}" />
                    <ToggleSwitch Grid.Column="1" x:Name="CleanSv" IsChecked="{Binding Cleanup.Autosaves}" />
                  </Grid>
                  <Separator />
                  <Grid ColumnDefinitions="*,Auto" Margin="{StaticResource PaddingTile}">
                    <TextBlock Text="{Binding [cleanup.permanent], Source={x:Static s:Loc.Instance}}"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="{StaticResource GapEnd}" />
                    <ToggleSwitch Grid.Column="1" x:Name="CleanPermanent" IsChecked="{Binding Cleanup.Permanent}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Drag to resize the two panels -->
      <GridSplitter Grid.Column="1" Classes="panel" />

      <!-- ================= Main ================= -->
      <DockPanel Grid.Column="2" Margin="{StaticResource PaddingMain}">

        <!-- Message from the publisher (news.json), until closed -->
        <Border DockPanel.Dock="Top" Classes="notice info" Margin="{StaticResource GapBelowLg}" IsVisible="{Binding HasBanner}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource IconInfo}" Margin="{StaticResource IconLead}" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceHair}">
              <TextBlock Text="{Binding Banner.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="caption" Text="{Binding Banner.Text}" TextWrapping="Wrap"
                         IsVisible="{Binding Banner.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Button Classes="link" Command="{Binding OpenBannerLinkCommand}" IsVisible="{Binding BannerHasLink}"
                      ToolTip.Tip="{Binding Banner.Link}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
                  <TextBlock Text="{Binding [news.open], Source={x:Static s:Loc.Instance}}" />
                  <PathIcon Data="{StaticResource IconExternal}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Button Grid.Column="2" Classes="icon" VerticalAlignment="Top" Command="{Binding DismissBannerCommand}"
                    ToolTip.Tip="{Binding [news.dismiss], Source={x:Static s:Loc.Instance}}">
              <PathIcon Data="{StaticResource IconClose}" Width="{StaticResource IconSizeXSmall}" Height="{StaticResource IconSizeXSmall}" />
            </Button>
          </Grid>
        </Border>

        <!-- Run panel (purge and convert) -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="{StaticResource GapBelowLg}" IsVisible="{Binding IsRunTab}">
          <StackPanel Spacing="{StaticResource Space3}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpaceHair}">
                <TextBlock Classes="title" Text="{Binding RunTitle}" />
                <TextBlock Classes="caption" Text="{Binding ScanText}" TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="1" Margin="{StaticResource GapStartLg}" VerticalAlignment="Center">
                <Button Classes="primary large" Command="{Binding StartCommand}" IsVisible="{Binding !IsRunning}" MinWidth="{StaticResource RunButtonMinWidth}"
                        HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
                    <PathIcon Data="{StaticResource IconPlay}" />
                    <TextBlock Text="{Binding [run.start], Source={x:Static s:Loc.Instance}}" />
                  </StackPanel>
                </Button>
                <Button Classes="large" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}"
                        IsEnabled="{Binding !IsStopping}" MinWidth="{StaticResource RunButtonMinWidth}" HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
                    <PathIcon Data="{StaticResource IconStop}" />
                    <TextBlock Text="{Binding [run.stop], Source={x:Static s:Loc.Instance}}" />
                  </StackPanel>
                </Button>
              </Panel>
            </Grid>

            <!-- Where to save -->
            <StackPanel Spacing="{StaticResource SpaceInline}">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Classes="section" Text="{Binding [options.output], Source={x:Static s:Loc.Instance}}"
                           VerticalAlignment="Center" Margin="{StaticResource GapEndLg}" />
                <Border Grid.Column="1" Classes="segmented">
                  <UniformGrid Rows="1">
                    <RadioButton Classes="segment" GroupName="mode" IsChecked="{Binding IsCopyMode}"
                                 Content="{Binding [output.copy.short], Source={x:Static s:Loc.Instance}}" />
                    <RadioButton Classes="segment" GroupName="mode" IsChecked="{Binding IsInPlaceMode}"
                                 Content="{Binding [output.inPlace.short], Source={x:Static s:Loc.Instance}}" />
                    <RadioButton Classes="segment" GroupName="mode" IsChecked="{Binding IsReplaceMode}"
                                 Content="{Binding [output.replace.short], Source={x:Static s:Loc.Instance}}" />
                    <RadioButton Classes="segment" GroupName="mode" IsChecked="{Binding IsReportOnlyMode}" IsVisible="{Binding !IsConvertMode}"
                                 Content="{Binding [output.reportOnly.short], Source={x:Static s:Loc.Instance}}" />
                  </UniformGrid>
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caption" Text="{Binding OutputHint}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Classes.warning="{Binding IsReplaceMode}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCopyMode}">
                <TextBox Text="{Binding OutputFolder}" IsReadOnly="True"
                         Watermark="{Binding [output.chooseFolder], Source={x:Static s:Loc.Instance}}">
                  <TextBox.InnerLeftContent>
                    <PathIcon Data="{StaticResource IconFolder}" Margin="{StaticResource GapStartMd}" Foreground="{DynamicResource TextMuted}" />
                  </TextBox.InnerLeftContent>
                </TextBox>
                <Button Grid.Column="1" x:Name="ChooseOutput" Margin="{StaticResource GapStartSm}"
                        Content="{Binding [common.browse], Source={x:Static s:Loc.Instance}}" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SpaceInline}">
              <ProgressBar Value="{Binding ProgressValue}" Maximum="{Binding ProgressMaximum}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caption" Text="{Binding ProgressText}" />
                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding [run.stopping], Source={x:Static s:Loc.Instance}}"
                           IsVisible="{Binding IsStopping}" />
              </Grid>
            </StackPanel>

            <!-- Summary -->
            <StackPanel Spacing="{StaticResource Space2}" IsVisible="{Binding HasSummary}">
              <!-- Sizes (3) and counts (4), with a wider gap between the two groups -->
              <Grid ColumnDefinitions="3*,4*" ColumnSpacing="{StaticResource Space4}">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource SpaceInline}">
                  <Border Classes="stat">
                    <StackPanel>
                      <TextBlock Classes="stat" Text="{Binding SummaryBefore}" />
                      <TextBlock Classes="caption" Text="{Binding [summary.before], Source={x:Static s:Loc.Instance}}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="stat">
                    <StackPanel>
                      <TextBlock Classes="stat" Text="{Binding SummaryAfter}" />
                      <TextBlock Classes="caption" Text="{Binding [summary.after], Source={x:Static s:Loc.Instance}}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Classes="stat Saved">
                    <StackPanel>
                      <TextBlock Classes="stat" Text="{Binding SummarySaved}" />
                      <TextBlock Classes="caption" Text="{Binding [summary.savedLabel], Source={x:Static s:Loc.Instance}}" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Grid Grid.Column="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="{StaticResource SpaceInline}">
                  <Border Classes="stat" Classes.Purged="{Binding AnyPurged}">
                    <StackPanel>
                      <TextBlock Classes="stat" Text="{Binding SummaryPurged}" />
                      <TextBlock Classes="caption" Text="{Binding SummaryDoneLabel}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="stat">
                    <StackPanel>
                      <TextBlock Classes="stat" Text="{Binding SummaryUnchanged}" />
                      <TextBlock Classes="caption" Text="{Binding [summary.unchanged], Source={x:Static s:Loc.Instance}}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Classes="stat" Classes.Skipped="{Binding AnySkipped}">
                    <StackPanel>
                      <TextBlock Classes="stat" Text="{Binding SummarySkipped}" />
                      <TextBlock Classes="caption" Text="{Binding [summary.skipped], Source={x:Static s:Loc.Instance}}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="3" Classes="stat" Classes.Failed="{Binding AnyFailed}">
                    <StackPanel>
                      <TextBlock Classes="stat" Text="{Binding SummaryFailed}" />
                      <TextBlock Classes="caption" Text="{Binding [summary.failed], Source={x:Static s:Loc.Instance}}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
              <Border Classes="notice info" IsVisible="{Binding SummaryIsEstimate}">
                <Grid ColumnDefinitions="Auto,*">
                  <PathIcon Data="{StaticResource IconInfo}" Margin="{StaticResource IconLead}" VerticalAlignment="Top" />
                  <TextBlock Grid.Column="1" Classes="caption" TextWrapping="Wrap"
                             Text="{Binding [summary.estimateNote], Source={x:Static s:Loc.Instance}}" />
                </Grid>
              </Border>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconInfo}" Width="{StaticResource IconSizeXSmall}" Height="{StaticResource IconSizeXSmall}" Foreground="{DynamicResource TextMuted}" />
                <TextBlock Classes="caption" Text="{Binding [cloud.note], Source={x:Static s:Loc.Instance}}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" Command="{Binding SaveReportCommand}" IsVisible="{Binding HasSummary}"
                      Padding="{StaticResource PaddingSegmentCompact}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
                  <PathIcon Data="{StaticResource IconDownload}" />
                  <TextBlock Text="{Binding [summary.saveReport], Source={x:Static s:Loc.Instance}}" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Run panel (cleanup) -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="{StaticResource GapBelowLg}" IsVisible="{Binding IsCleanMode}">
          <StackPanel Spacing="{StaticResource Space3}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpaceHair}">
                <TextBlock Classes="title" Text="{Binding [tab.cleanup], Source={x:Static s:Loc.Instance}}" />
                <TextBlock Classes="caption" Text="{Binding [cleanup.description], Source={x:Static s:Loc.Instance}}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding ScanText}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="primary large" Margin="{StaticResource GapStartLg}" MinWidth="{StaticResource RunButtonMinWidth}" VerticalAlignment="Center"
                      HorizontalContentAlignment="Center" Command="{Binding CleanCommand}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
                  <PathIcon Data="{StaticResource IconBroom}" />
                  <TextBlock Text="{Binding [cleanup.run], Source={x:Static s:Loc.Instance}}" />
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Classes="subtitle" Text="{Binding CleanupText}" TextWrapping="Wrap"
                       IsVisible="{Binding CleanupText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <!-- Results -->
        <Border Classes="card" Padding="0" IsVisible="{Binding IsRunTab}" ClipToBounds="True">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="3*,1.3*,1.8*,0.8*,1*,0.7*" Margin="{StaticResource PaddingRow}">
              <CheckBox Classes="compact" IsThreeState="True" IsChecked="{Binding AllSelected}" IsEnabled="{Binding !IsRunning}"
                        IsVisible="{Binding HasRows}" ToolTip.Tip="{Binding [results.selectAll], Source={x:Static s:Loc.Instance}}">
                <TextBlock Classes="section" Text="{Binding SelectionText}" />
              </CheckBox>
              <TextBlock Classes="section" Text="{Binding [results.col.file], Source={x:Static s:Loc.Instance}}"
                         IsVisible="{Binding !HasRows}" />
              <TextBlock Grid.Column="1" Classes="section" Text="{Binding [results.col.status], Source={x:Static s:Loc.Instance}}" />
              <TextBlock Grid.Column="2" Classes="section" Text="{Binding [results.col.size], Source={x:Static s:Loc.Instance}}" />
              <TextBlock Grid.Column="3" Classes="section" Text="{Binding [results.col.removed], Source={x:Static s:Loc.Instance}}" />
              <TextBlock Grid.Column="4" Classes="section" Text="{Binding [results.col.engine], Source={x:Static s:Loc.Instance}}" />
              <TextBlock Grid.Column="5" Classes="section" Text="{Binding [results.col.time], Source={x:Static s:Loc.Instance}}" />
            </Grid>
            <Panel>
              <!-- Empty state -->
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource Space2}"
                          MaxWidth="{StaticResource EmptyStateMaxWidth}" IsVisible="{Binding !HasRows}">
                <Border Classes="iconTile" Width="{StaticResource IconTileSizeLarge}" Height="{StaticResource IconTileSizeLarge}" HorizontalAlignment="Center">
                  <PathIcon Data="{StaticResource IconFile}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}" />
                </Border>
                <TextBlock Classes="subtitle" HorizontalAlignment="Center"
                           Text="{Binding [results.title], Source={x:Static s:Loc.Instance}}" />
                <TextBlock Classes="caption" TextAlignment="Center" TextWrapping="Wrap"
                           Text="{Binding [results.empty], Source={x:Static s:Loc.Instance}}" />
              </StackPanel>

              <!-- Virtualized: only the rows on screen are created, so tens of thousands of files stay fast -->
              <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
                  <ItemsControl.Template>
                    <ControlTemplate>
                      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                      </ScrollViewer>
                    </ControlTemplate>
                  </ItemsControl.Template>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="resultRow" Classes.excluded="{Binding !IsChecked}" ToolTip.Tip="{Binding ReasonDetail}">
                        <Grid ColumnDefinitions="3*,1.3*,1.8*,0.8*,1*,0.7*">
                          <!-- The whole name is the checkbox label, so a click on the name selects the file -->
                          <CheckBox Margin="{StaticResource GapEnd}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                    IsChecked="{Binding IsChecked}"
                                    IsEnabled="{Binding !$parent[ItemsControl].DataContext.IsRunning}">
                            <StackPanel>
                              <TextBlock Text="{Binding File}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="caption warning" Text="{Binding Reason}" TextWrapping="Wrap"
                                         IsVisible="{Binding HasReason}" />
                              <!-- inside the label, but a button: clicking it does not untick the file -->
                              <Button Classes="link" Command="{Binding ShowLogCommand}" IsVisible="{Binding HasLog}"
                                      ToolTip.Tip="{Binding LogPath}" Margin="{StaticResource GapTopXs}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
                                  <PathIcon Data="{StaticResource IconDocument}" />
                                  <TextBlock Text="{Binding [results.showLog], Source={x:Static s:Loc.Instance}}" />
                                </StackPanel>
                              </Button>
                            </StackPanel>
                          </CheckBox>
                          <Border Grid.Column="1" Classes="status" IsVisible="{Binding ShowStatus}" Classes.Purged="{Binding IsPurged}"
                                  Classes.Skipped="{Binding IsSkipped}" Classes.Failed="{Binding IsFailed}"
                                  Classes.Running="{Binding IsRunning}">
                            <TextBlock Text="{Binding Status}" />
                          </Border>
                          <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="secondary" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding Removed}" VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding RemovedDetail}" />
                          <TextBlock Grid.Column="4" Text="{Binding Engine}" Classes="secondary" VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding EngineTip}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="5" Text="{Binding Time}" Classes="secondary" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </DockPanel>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
