<!--
  Light / Dark pill. The active side is raised. Add Classes="compact" for icons only (title bar).
  DataContext must expose two-way bool properties IsLight and IsDark (MainViewModel, WelcomeViewModel).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:PurgeCad.App.Services"
             xmlns:c="using:PurgeCad.App.Controls"
             x:Class="PurgeCad.App.Controls.ThemeSwitch">
  <UserControl.Styles>
    <Style Selector="c|ThemeSwitch.compact TextBlock.label"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="c|ThemeSwitch.compact RadioButton.segment"><Setter Property="Padding" Value="{StaticResource PaddingSegmentCompact}" /></Style>
  </UserControl.Styles>
  <Border Classes="segmented">
    <UniformGrid Columns="2">
      <RadioButton Classes="segment" IsChecked="{Binding IsLight}"
                   ToolTip.Tip="{Binding [theme.light], Source={x:Static s:Loc.Instance}}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
          <PathIcon Data="{StaticResource IconSun}" />
          <TextBlock Classes="label" Text="{Binding [theme.light], Source={x:Static s:Loc.Instance}}" VerticalAlignment="Center" />
        </StackPanel>
      </RadioButton>
      <RadioButton Classes="segment" IsChecked="{Binding IsDark}"
                   ToolTip.Tip="{Binding [theme.dark], Source={x:Static s:Loc.Instance}}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
          <PathIcon Data="{StaticResource IconMoon}" />
          <TextBlock Classes="label" Text="{Binding [theme.dark], Source={x:Static s:Loc.Instance}}" VerticalAlignment="Center" />
        </StackPanel>
      </RadioButton>
    </UniformGrid>
  </Border>
</UserControl>
